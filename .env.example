# GlideX Web App — Environment Variables
# Copy this file to .env and fill in the values
# Use the same Supabase credentials as the mobile app

EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Document Signing Feature (isolated Supabase project)
VITE_SIGNING_SUPABASE_URL=your_signing_supabase_url_here
VITE_SIGNING_SUPABASE_ANON_KEY=your_signing_supabase_anon_key_here