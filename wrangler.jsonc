{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glidex-web",
  "account_id": "e628db24691313d5ce1f3b5dfbe441d6",
  "compatibility_date": "2025-02-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "glidexp.com",
      "custom_domain": true
    },
    {
      "pattern": "www.glidexp.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
